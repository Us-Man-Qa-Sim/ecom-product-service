# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=info

# ── gRPC ──
GRPC_HOST=0.0.0.0
GRPC_PORT=5002

# ── HTTP (health only; not exposed publicly) ──
HTTP_HOST=0.0.0.0
HTTP_PORT=8082

# ── MongoDB (Mongoose) ──
# Must point at the `rs0` replica set — multi-document transactions (stock
# reservation, KFK-2) require it. Match infra/.env credentials. The compose
# network form is:
#   mongodb://<user>:<pass>@mongo:27017/product?authSource=admin&replicaSet=rs0
MONGO_URI=mongodb://product_svc:changeme@localhost:27017/product?authSource=admin&replicaSet=rs0

# ── Kafka (producer/consumer wiring lands in the Kafka phase — KFK-2/KFK-3) ──
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=product-service
