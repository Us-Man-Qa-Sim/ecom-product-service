# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=info

# ── gRPC ──
GRPC_HOST=0.0.0.0
GRPC_PORT=5002

# ── HTTP (health only; not exposed publicly) ──
HTTP_HOST=0.0.0.0
HTTP_PORT=8082

# ── MongoDB (Mongoose) ──
# Must point at the `rs0` replica set — multi-document transactions (stock
# reservation, KFK-2) require it. Match infra/.env credentials. The compose
# network form is:
#   mongodb://<user>:<pass>@mongo:27017/product?authSource=admin&replicaSet=rs0
MONGO_URI=mongodb://product_svc:changeme@localhost:27017/product?authSource=admin&replicaSet=rs0

# ── Kafka ──
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=product-service
# Consumer for order.created / order.cancelled / order.shipped (KFK-2/5/6).
# A failing handler is retried with exponential backoff; after MAX_RETRIES it
# is logged as a poison message and its offset committed (no DLQ yet — STR-1).
KAFKA_CONSUMER_GROUP_ID=product-service
KAFKA_CONSUMER_MAX_RETRIES=5
KAFKA_CONSUMER_RETRY_BASE_MS=1000
KAFKA_CONSUMER_RETRY_MAX_MS=30000

# ── Outbox relay (KFK-3) ──
# Claims unsent rows with a lease, publishes, then stamps sentAt. A row claimed
# by a relay that crashed is re-claimed once CLAIM_TTL_MS passes; keep it above
# the 30 s producer send timeout.
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_POLL_INTERVAL_MS=250
OUTBOX_RELAY_BATCH_SIZE=32
OUTBOX_RELAY_ERROR_BACKOFF_MS=5000
OUTBOX_RELAY_CLAIM_TTL_MS=60000
